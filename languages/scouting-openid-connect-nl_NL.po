msgid "The supported scopes are:"
msgstr "De ondersteunde scopes zijn:"

#: auth/OpenIDConnectClient.php:207
msgid "The token_endpoint is not available in the well-known data."
msgstr "Het token_endpoint is niet beschikbaar in de well-known data."

#: auth/OpenIDConnectClient.php:217
msgid "The code_verifier for PKCE is missing from the session."
msgstr "De code_verifier voor PKCE ontbreekt in de sessie."

#: auth/OpenIDConnectClient.php:254
#, php-format
msgid "Token endpoint error %1$s: %2$s"
msgstr "Token-eindpuntfout %1$s: %2$s"

#: auth/OpenIDConnectClient.php:306
msgid "The ID token is not available in the tokens."
msgstr "Het ID-token is niet beschikbaar in de tokens."

#: auth/OpenIDConnectClient.php:312
msgid "The JSON Web Key Set (JWKS) is not available."
msgstr "De JSON Web Key Set (JWKS) is niet beschikbaar."

#: auth/OpenIDConnectClient.php:319
msgid "The ID token has an invalid structure."
msgstr "Het ID-token heeft een ongeldige structuur."

#: auth/OpenIDConnectClient.php:333
msgid "The ID token uses an unexpected signing algorithm."
msgstr "Het ID-token maakt gebruik van een onverwacht ondertekeningsalgoritme."

#: auth/OpenIDConnectClient.php:348
msgid "The certificate chain (x5c) for the key ID (kid) specified in the header was not found."
msgstr "De certificaatketen (x5c) voor de sleutel-ID (kid) in de koptekst is niet gevonden."

#: auth/OpenIDConnectClient.php:363
msgid "The signing certificate used to validate the ID token is invalid or unsupported."
msgstr ""
"Het ondertekeningscertificaat dat wordt gebruikt om het ID-token te valideren, is ongeldig of "
"wordt niet ondersteund."

#: auth/OpenIDConnectClient.php:370
msgid "The signature in the ID token is not valid."
msgstr "De handtekening in het ID-token is niet geldig."

#: auth/OpenIDConnectClient.php:376
msgid "The ID token payload could not be decoded."
msgstr "The ID token payload could not be decoded."

#: auth/OpenIDConnectClient.php:382
msgid "The ID token was issued by an unexpected issuer."
msgstr "Het ID-token is uitgegeven door een onbekende uitgever."

#: auth/OpenIDConnectClient.php:389
msgid "The ID token was not issued for this client."
msgstr "Er is geen ID-token voor deze klant aangemaakt."

#: auth/OpenIDConnectClient.php:395
msgid "The ID token has expired."
msgstr "Het ID-token is verlopen."

#: auth/OpenIDConnectClient.php:401
msgid "The ID token has an invalid issued-at timestamp."
msgstr "Het ID-token heeft een ongeldige tijdstempel voor de uitgiftedatum."

#: auth/OpenIDConnectClient.php:407
msgid "The ID token is missing the required sub claim."
msgstr "De vereiste subclaim ontbreekt in het ID-token."

#: auth/OpenIDConnectClient.php:413
msgid "The login session is invalid or has expired."
msgstr "De inlogsessie is ongeldig of is verlopen."

#: auth/OpenIDConnectClient.php:419
msgid "The ID token is missing the required nonce claim."
msgstr "De vereiste nonce-claim ontbreekt in het ID-token."

#: auth/OpenIDConnectClient.php:424
msgid "The ID token nonce is invalid."
msgstr "De nonce van het ID-token is ongeldig."

#: auth/OpenIDConnectClient.php:446
msgid "The userinfo_endpoint is not available in the well-known data."
msgstr "Het userinfo_endpoint is niet beschikbaar in de well-known data."

#: auth/OpenIDConnectClient.php:458
msgid "The access token is not available in the tokens."
msgstr "Het toegangstoken is niet beschikbaar in de tokens."

#: auth/OpenIDConnectClient.php:487
msgid "The UserInfo endpoint returned an unexpected response."
msgstr "Het UserInfo-eindpunt heeft een onverwacht antwoord geretourneerd."

#: auth/OpenIDConnectClient.php:497
msgid "The UserInfo endpoint returned invalid user data."
msgstr "Het UserInfo-eindpunt heeft ongeldige gebruikersgegevens geretourneerd."

#: auth/OpenIDConnectClient.php:507
msgid "The UserInfo response is missing the required sub claim."
msgstr "De vereiste subclaim ontbreekt in het UserInfo-antwoord."

#: auth/OpenIDConnectClient.php:516
msgid "The UserInfo response belongs to a different subject."
msgstr "Het UserInfo-antwoord hoort bij een ander subject."

#: auth/OpenIDConnectClient.php:684 auth/OpenIDConnectClient.php:743
msgid "No additional details provided."
msgstr "Geen aanvullende details verstrekt."

#: auth/OpenIDConnectClient.php:685
msgid "When retrieving well-known data, the status code was:"
msgstr "Bij het ophalen van well-known data was de statuscode:"

#: auth/OpenIDConnectClient.php:716
msgid "The jwks_uri is not available in the well-known data."
msgstr "De jwks_uri is niet beschikbaar in de well-known data."

#: auth/OpenIDConnectClient.php:722
msgid "The jwks_uri is not a valid URL."
msgstr "De jwks_uri is geen geldige URL."

#: auth/OpenIDConnectClient.php:722
msgid "The jwks_uri is not valid:"
msgstr "De jwks_uri is niet geldig:"

#: auth/OpenIDConnectClient.php:744
msgid "When retrieving JWKS data, the status code was:"
msgstr "Bij het ophalen van JWKS-gegevens was de statuscode:"

#: auth/OpenIDConnectClient.php:792
msgid "Authentication is temporarily unavailable. Please try again later."
msgstr "Verificatie is tijdelijk niet beschikbaar. Probeer het later nog eens."

#: logging/Download.php:17 logging/Page.php:69
msgid "You do not have sufficient permissions to export logs."
msgstr "U beschikt niet over voldoende rechten om logbestanden te exporteren."

#: logging/Help.php:21
msgid "Overview"
msgstr "Overzicht"

#: logging/Help.php:23
msgid "This screen shows the plugin logs stored in the database table scouting_oidc_logs."
msgstr ""
"Op dit scherm worden de logbestanden van de plug-in weergegeven die zijn opgeslagen in de "
"databasetabel scouting_oidc_logs."

#: logging/Help.php:24
msgid ""
"Each row contains a timestamp, severity level, component, optional user details, and the log "
"message."
msgstr ""
"Elke rij bevat een tijdstempel, een ernstgraad, een component, optionele gebruikersgegevens en "
"het logbericht."

#: logging/Help.php:25
msgid ""
"Log timestamps are stored in UTC in the database and displayed using the WordPress site timezone."
msgstr ""
"Logtijdstempels worden in de database opgeslagen in UTC en weergegeven in de tijdzone van de "
"WordPress-site."

#: logging/Help.php:30
msgid "Filtering and Search"
msgstr "Filteren en zoeken"

#: logging/Help.php:32
msgid ""
"Use the filter controls to narrow results by date/time range, level, component, user ID or SOL "
"ID."
msgstr ""
"Gebruik de filteropties om de resultaten te verfijnen op basis van datum/tijd, niveau, "
"onderdeel, gebruikers-ID of SOL-ID."

#: logging/Help.php:33
msgid "Use the search box to find text in the message field."
msgstr "Gebruik het zoekvak om tekst in het berichtveld te zoeken."

#: logging/Help.php:34
msgid "The Reset button clears filters and returns to the latest entries."
msgstr ""
"Met de knop Reset worden de filters gewist en keert u terug naar de meest recente vermeldingen."

#: logging/Help.php:39
msgid "Export and Retention"
msgstr "Export en behoud"

#: logging/Help.php:41
msgid "Use the Download .log button to export the currently filtered logs."
msgstr "Gebruik de knop ‘.log downloaden’ om de momenteel gefilterde logbestanden te exporteren."

#: logging/Help.php:45
#, php-format
msgid "A daily cleanup task removes log entries older than %d day(s)."
msgstr "Een dagelijkse opschoning verwijdert logboekvermeldingen die ouder zijn dan %d dag(en)."

#: logging/Help.php:53
msgid "Debug Logging"
msgstr "Loggen van Debug"

#: logging/Help.php:55
msgid "Debug-level entries are stored only when Enable debug logs is checked in General Settings."
msgstr ""
"Vermeldingen op debug-level worden alleen opgeslagen als de optie ‘Debug log inschakelen’ is "
"aangevinkt in de algemene instellingen."

#: logging/Help.php:56
msgid ""
"When WP_DEBUG is enabled, plugin log messages are also mirrored to the WordPress/PHP error log."
msgstr ""
"Wanneer WP_DEBUG is ingeschakeld, worden de logberichten van de plug-in ook opgenomen in het "
"WordPress/PHP-foutenlogboek."

#: logging/Help.php:60
msgid "Need more help?"
msgstr "Heb je nog meer hulp nodig?"

#: logging/Help.php:61
msgid "Open the Support page"
msgstr "Ga naar de support pagina"

