msgstr "Onderliggende organisaties meenemen"

#: woocommerce/class-woocommercerestrictions.php:252
msgid "Allowed SOL roles"
msgstr "Toegestane SOL-rollen"

#: woocommerce/class-woocommercerestrictions.php:253
msgid "No role allow rule"
msgstr "Geen toestemmingsregel voor rollen"

#: woocommerce/class-woocommercerestrictions.php:260
#: woocommerce/class-woocommercerestrictions.php:295
